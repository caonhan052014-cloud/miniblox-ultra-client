{
  "manifest_version": 3,
  "name": "MiniBlox Ultra Client",
  "version": "2.0.0",
  "description": "MiniBlox client panel with working visual QoL modules, FPS/CPS, draggable windows and hotkey.",
  "permissions": [],
  "host_permissions": [
    "https://miniblox.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://miniblox.io/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
